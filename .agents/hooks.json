{
  "simon-session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 scripts/session_start.py",
        "timeout": 5
      }
    ]
  },
  "simon-toolchain-permissions": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/auto_approve_toolchain.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
