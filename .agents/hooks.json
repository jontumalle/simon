{
  "simon-session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 scripts/session_start.py",
        "timeout": 5
      }
    ]
  },
  "simon-toolchain-permissions": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/auto_approve_toolchain.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "simon-stop-doc-sync": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 scripts/stop_doc_sync.py",
        "timeout": 5
      }
    ]
  }
}
