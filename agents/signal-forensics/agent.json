{
  "id": "simon-signal-forensics",
  "description": "Stage 2 Phase B parallel agent: samples up to 50 public comments and classifies them in one pass using merged generic and domain intent buckets.",
  "base_agent": "antigravity-preview-09-2026",
  "agent_config": {
    "type": "antigravity",
    "model": "gemini-4-argon",
    "max_total_tokens": "64000"
  },
  "system_instruction_file": "SYSTEM.md",
  "tools": [
    {
      "type": "url_context"
    },
    {
      "type": "code_execution"
    }
  ],
  "base_environment": {
    "type": "remote",
    "env": {
      "SIMON_DOMAIN": "music",
      "SIMON_DB_URL": "https://simon-staging-139550420825.us-east1.run.app",
      "SIMON_AGENT_DB_TOKEN": {
        "credential": "simon-db-token"
      },
      "YOUTUBE_API_KEY": {
        "credential": "youtube-api-key"
      }
    }
  },
  "shared_skills": [
    "simon-db",
    "youtube",
    "field-reporting"
  ]
}
